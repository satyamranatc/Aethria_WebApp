{
  "name": "aethria",
  "displayName": "Aethria — AI Coding & Project Intelligence",
  "description": "Cutting-edge AI coding and project intelligence platform developed by Satyam Rana. Instant syntax repair, multi-line formatting, architectural documentation, and cloud workspace sync.",
  "version": "4.7.0",
  "publisher": "SatyamRana",
  "author": {
    "name": "Satyam Rana",
    "url": "https://satyamrana.in"
  },
  "license": "MIT",
  "homepage": "https://www.aethria.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/satyamranatc/Aethria_WebApp.git"
  },
  "bugs": {
    "url": "https://github.com/satyamranatc/Aethria_WebApp/issues"
  },
  "qna": "marketplace",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#0F172A",
    "theme": "dark"
  },
  "keywords": [
    "ai",
    "copilot",
    "coding assistant",
    "fix code",
    "code formatter",
    "code review",
    "satyam rana",
    "groq",
    "neural voice",
    "aethria"
  ],
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Formatters",
    "Education",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:aethria.sidebar",
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aethria-view",
          "title": "Aethria",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "aethria-view": [
        {
          "type": "webview",
          "id": "aethria.sidebar",
          "name": "Aethria"
        }
      ]
    },
    "commands": [
      {
        "command": "aethria.fixCode",
        "title": "Aethria: Fix & Format Code",
        "icon": "$(zap)"
      },
      {
        "command": "aethria.explainCode",
        "title": "Aethria: Explain & Add Comments",
        "icon": "$(lightbulb)"
      },
      {
        "command": "aethria.sync",
        "title": "Aethria: Sync Project",
        "icon": "$(sync)"
      },
      {
        "command": "aethria.reviewChanges",
        "title": "Aethria: Review & Apply Remote AI Changes",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "aethria.connect",
        "title": "Aethria: Connect Account",
        "icon": "$(link)"
      },
      {
        "command": "aethria.disconnect",
        "title": "Aethria: Disconnect Account",
        "icon": "$(log-out)"
      },
      {
        "command": "aethria.openWeb",
        "title": "Aethria: Open Web Intelligence Studio",
        "icon": "$(globe)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "aethria.fixCode",
          "group": "1_modification@1",
          "when": "editorTextFocus"
        },
        {
          "command": "aethria.explainCode",
          "group": "1_modification@2",
          "when": "editorTextFocus"
        }
      ],
      "view/title": [
        {
          "command": "aethria.fixCode",
          "when": "view == aethria.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "aethria.explainCode",
          "when": "view == aethria.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "aethria.sync",
          "when": "view == aethria.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "aethria.openWeb",
          "when": "view == aethria.sidebar",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "Aethria",
      "properties": {
        "aethria.serverUrl": {
          "type": "string",
          "default": "https://aethria-backend.onrender.com",
          "description": "Backend API endpoint for Aethria Intelligence service."
        },
        "aethria.webUrl": {
          "type": "string",
          "default": "https://www.aethria.in",
          "description": "Web Studio URL for Aethria Intelligence."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.15.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
