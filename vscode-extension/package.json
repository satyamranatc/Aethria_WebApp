{
  "name": "aethria",
  "displayName": "Aethria",
  "description": "The cutting-edge AI coding and project intelligence assistant developed by Satyam Rana. Connect your local workspace directly to Aethria.",
  "version": "1.0.0",
  "publisher": "aethria",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Education",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aethria-view",
          "title": "Aethria",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "aethria-view": [
        {
          "type": "webview",
          "id": "aethria.sidebar",
          "name": "Aethria"
        }
      ]
    },
    "commands": [
      {
        "command": "aethria.fixCode",
        "title": "Aethria: Fix & Format Code",
        "icon": "$(zap)"
      },
      {
        "command": "aethria.explainCode",
        "title": "Aethria: Explain & Add Comments",
        "icon": "$(lightbulb)"
      },
      {
        "command": "aethria.sync",
        "title": "Aethria: Sync Project",
        "icon": "$(sync)"
      },
      {
        "command": "aethria.connect",
        "title": "Aethria: Connect Account",
        "icon": "$(link)"
      },
      {
        "command": "aethria.disconnect",
        "title": "Aethria: Disconnect Account",
        "icon": "$(log-out)"
      },
      {
        "command": "aethria.openWeb",
        "title": "Aethria: Open Web Intelligence Studio",
        "icon": "$(globe)"
      },
      {
        "command": "aethria.viewDiff",
        "title": "Aethria: Review Pending Remote Diff"
      },
      {
        "command": "aethria.applyChange",
        "title": "Aethria: Apply Approved Change"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "aethria.fixCode",
          "group": "1_modification@1",
          "when": "editorTextFocus"
        },
        {
          "command": "aethria.explainCode",
          "group": "1_modification@2",
          "when": "editorTextFocus"
        }
      ],
      "view/title": [
        {
          "command": "aethria.fixCode",
          "when": "view == aethria.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "aethria.explainCode",
          "when": "view == aethria.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "aethria.sync",
          "when": "view == aethria.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "aethria.openWeb",
          "when": "view == aethria.sidebar",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "Aethria",
      "properties": {
        "aethria.serverUrl": {
          "type": "string",
          "default": "https://aethria-backend.onrender.com",
          "description": "Backend API endpoint for Aethria Intelligence service."
        },
        "aethria.webUrl": {
          "type": "string",
          "default": "https://www.aethria.in",
          "description": "Web Studio URL for Aethria Intelligence."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.15.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
